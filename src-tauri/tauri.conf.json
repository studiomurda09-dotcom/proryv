{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proryv",
  "version": "0.3.0",
  "identifier": "dev.proryv.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Proryv",
        "width": 1130,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFRTVDN0Y0MTMwREE1MDkKUldRSnBRMFQ5TWZsenVSZUc2ZGg5M0k0ZFNEcVpoRFRWLzZPMVVmNXp4Q3dGWnZKZW91VjBoTWQK",
      "endpoints": ["https://github.com/studiomurda09-dotcom/proryv/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Proryv",
    "category": "Utility",
    "shortDescription": "Обход DPI с автоподбором стратегий",
    "longDescription": "Proryv обходит DPI-блокировки (YouTube, Discord и др.) и сам подбирает стратегию под вашего провайдера.",
    "copyright": "© 2026 studiomurda09-dotcom. GPL-3.0",
    "resources": {
      "../third_party/windivert/WinDivert.dll": "WinDivert.dll",
      "../third_party/windivert/WinDivert64.sys": "WinDivert64.sys"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "ru-RU"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
